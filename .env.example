# Lead capture — copy to Vercel project env vars (never commit real values).
# Without these, /api/enquiries returns 503 and the form falls back to the
# WhatsApp handoff, so no lead is ever silently lost.

# Neon serverless Postgres connection string (pooled). Create a free project
# at https://neon.tech, run db/migrations/001_enquiries.sql in the SQL editor,
# then paste the connection string here.
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# WhatsApp Cloud API (Meta) — team notification for new leads.
# 1. Create an app at https://developers.facebook.com, add the WhatsApp product.
# 2. Use the test or production phone number; copy its Phone number ID.
# 3. Generate a permanent access token (or system-user token).
# 4. In WhatsApp Manager, create + approve a UTILITY template named below.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Recipient of lead alerts — production team number (country code, no +).
WHATSAPP_TEAM_NUMBER=918171158569
# Template name + language, must match the approved template exactly.
WHATSAPP_TEMPLATE_NAME=mqt_lead_alert
WHATSAPP_TEMPLATE_LANG=en
