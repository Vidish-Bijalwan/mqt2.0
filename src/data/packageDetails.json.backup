        "description": ""
      },
      {
        "title": "Day 4 :Kushinagar \u2013 Lumbini (180km / 5hours)",
        "description": ""
      },
      {
        "title": "Day 5 :Lumbini \u2013 Kapilavastu \u2013 Sravasti (225km / 5hrs 30mines)",
        "description": ""
      },
